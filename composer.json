{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "24slides/laravel-saml2": "^2.0",
        "awobaz/compoships": "2.3.0",
        "barryvdh/laravel-snappy": "^1.0",
        "darkaonline/l5-swagger": "^8.3",
        "doctrine/dbal": "^3.6",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-log-reader": "^1.0",
        "jeremykenedy/laravel-logger": "^6.0",
        "laravel-notification-channels/webpush": "8.0",
        "laravel/framework": "^10.10",
        "laravel/horizon": "^5.24",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "league/flysystem-ftp": "^3.29",
        "maatwebsite/excel": "^3.1",
        "mike42/escpos-php": "^4.0",
        "mongodb/laravel-mongodb": "^5.1",
        "phpoffice/phpword": "^1.4",
        "pragmarx/google2fa-laravel": "^2.3",
        "predis/predis": "^2.2",
        "spatie/pdf-to-text": "^1.54",
        "symfony/dom-crawler": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "ext-pcntl": "8.0",
            "ext-posix": "8.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

# --- Core databases (all required by the /install wizard) ---
# Each connection name is fixed in config/code; DB_*_DRIVER lets you choose
# its driver (sqlsrv|mysql|pgsql|sqlite) without renaming the connection.
DB_CD_CONNECTION=sqlsrv_conn_dyn
DB_CD_DRIVER=sqlsrv
DB_CD_HOST=127.0.0.1
DB_CD_PORT=1433
DB_CD_DATABASE=STX_PORTAL
DB_CD_USERNAME=sa
DB_CD_PASSWORD=

